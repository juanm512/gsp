# Local Development Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# REDIS (Local Docker)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# DATABASE (Supabase or Local PostgreSQL)
# ============================================
# Option A: Use your existing Supabase
POSTGRES_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Option B: Local PostgreSQL
# POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/gsp"

# ============================================
# S3/R2 STORAGE
# ============================================
# Use your real Cloudflare R2 credentials for local testing
S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID="your-r2-access-key"
AWS_SECRET_ACCESS_KEY="your-r2-secret-key"
S3_ENDPOINT_URL="https://your-account-id.r2.cloudflarestorage.com"

# ============================================
# MODAL GPU FUNCTIONS (Mock for local dev)
# ============================================
# When running the mock server (pnpm dev:mock):
MODAL_COLMAP_URL="http://localhost:8001/colmap"
MODAL_BRUSH_URL="http://localhost:8001/brush"
MODAL_TOKEN="local-dev-token"

# When testing with real Modal (after deployment):
# MODAL_COLMAP_URL="https://your-workspace--colmap-processor-run-colmap.modal.run"
# MODAL_BRUSH_URL="https://your-workspace--brush-processor-train-gaussian-splatting.modal.run"
# MODAL_TOKEN="your-modal-token"

# ============================================
# AUTH (Required for app)
# ============================================
AUTH_SECRET="your-auth-secret" # Generate with: openssl rand -base64 32
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"

# Base URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY="your-resend-api-key"
EMAIL_TEST_MODE="true" # Set to true to send all emails to test address
VERIFIED_EMAIL_DOMAIN="your-verified-domain.com" # Optional

# ============================================
# OPTIONAL: Development Helpers
# ============================================
# Enable verbose logging
# DEBUG="bullmq:*"
# NODE_ENV="development"
