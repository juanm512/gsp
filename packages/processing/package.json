{
  "name": "@acme/processing",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "start": "tsx src/workers.ts",
    "start:cpu": "WORKER_TYPE=frame-extractor,image-validator,sog-converter tsx src/workers.ts",
    "start:gpu": "WORKER_TYPE=colmap,brush tsx src/workers.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config",
  "dependencies": {
    "@acme/db": "workspace:*",
    "bullmq": "^5.66.5",
    "ioredis": "^5.9.1"
  }
}