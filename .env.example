# Copiá este archivo a `.env` y completá los valores.
# Este archivo se versiona: NO pongas secretos reales acá.

# Base de datos (PostgreSQL)
# Con `docker compose up -d`: postgresql://gsp_user:gsp_secret@localhost:5433/gaussian_db
POSTGRES_URL="postgresql://gsp_user:gsp_secret@localhost:5433/gaussian_db"

# Redis (BullMQ). Con docker compose: redis://localhost:6380
REDIS_URL="redis://localhost:6380"

# Auth (Better Auth)
AUTH_SECRET="generar con: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (pendiente de activar)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Facturación (Polar)
POLAR_WEBHOOK_SECRET=""
POLAR_ACCESS_TOKEN=""

# Almacenamiento S3 / Cloudflare R2
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com/BUCKET_NAME"
STORAGE_BUCKET_NAME=""
STORAGE_PUBLIC_URL=""

# Email transaccional (Resend)
RESEND_API_KEY=""
# En desarrollo, "true" redirige todos los emails a la casilla de prueba
EMAIL_TEST_MODE="true"
# Dominio verificado en Resend. Vacío usa onboarding@resend.dev
VERIFIED_EMAIL_DOMAIN=""

# Workers GPU en Modal (pipeline de procesamiento)
MODAL_COLMAP_URL=""
MODAL_BRUSH_URL=""
MODAL_TOKEN=""

# URLs públicas de las apps
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
