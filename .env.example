# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# Database (PostgreSQL)
# For local Docker: postgresql://gsp_user:gsp_secret_2024@localhost:5433/gaussian_db
POSTGRES_URL="postgresql://user:password@localhost:5432/gaussian_db"

# Redis
REDIS_URL="redis://localhost:6380"

# Auth
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"

# Google OAuth (uncomment when ready)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Billing
POLAR_WEBHOOK_SECRET=""
POLAR_ACCESS_TOKEN=""

# S3/R2 Storage
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com/BUCKET_NAME"
STORAGE_BUCKET_NAME=""
STORAGE_PUBLIC_URL=""

# Email (Resend)
RESEND_API_KEY=""
# Set to "true" in development to send all emails to test email (512juanm@gmail.com)
# Set to "false" or omit in production to send emails to actual recipients
EMAIL_TEST_MODE="true"
# Your verified domain in Resend (e.g., "gsp.com"). Leave empty to use onboarding@resend.dev
VERIFIED_EMAIL_DOMAIN=""

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Modal
MODAL_COLMAP_URL="https://..."
MODAL_BRUSH_URL="https://..."
MODAL_TOKEN="..." # Desde Modal dashboard